---
type Props = {
  variant?: "primary" | "secondary" | "outline" | "ghost" | "danger";
  size?: "sm" | "md" | "lg" | "xl";
  type?: "button" | "submit" | "reset";
  disabled?: boolean;
  fullWidth?: boolean;
  href?: string;
  target?: string;
  class?: string;
  id?: string;
  ariaLabel?: string;
  [key: string]: any;
};

const {
  variant = "primary",
  size = "md",
  type = "button",
  disabled = false,
  href,
  target,
  class: className = "",
  id,
  ariaLabel,
  ...props
} = Astro.props;

const baseStyles
  = "inline-flex items-center justify-center font-medium transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed";

const variants = {
  primary:
    "bg-primary-500 text-white hover:bg-primary-600 focus:ring-primary-500/50 focus:ring-2 active:bg-primary-700",
  secondary:
    "bg-secondary-500 text-white hover:bg-secondary-600 focus:ring-secondary-500/50 focus:ring-2 active:bg-secondary-700",
  accent: "bg-accent-500 text-white hover:bg-accent-600 focus:ring-accent-500/50 focus:ring-2 active:bg-accent-700",
  outline:
    "border-2 border-primary-300 text-primary-600 hover:bg-primary-50 focus:ring-primary-500/30 focus:ring-2 active:bg-primary-100",
  ghost: "text-primary-600 hover:bg-primary-100 focus:ring-primary-500/30 focus:ring-2 active:bg-primary-200",
  danger: "bg-red-700 text-white hover:bg-red-500 focus:ring-red-500/50 focus:ring-2 active:bg-red-700",
};

const sizes = {
  sm: "h-8 px-3 text-xs",
  md: "h-10 px-4 text-sm",
  lg: "h-11 px-8 text-base",
  xl: "h-12 px-10 text-lg",
};

const buttonClasses = [baseStyles, variants[variant], sizes[size], className].filter(Boolean).join(" ");
const Element = href ? "a" : "button";
---

<Element
  {...props}
  class={buttonClasses}
  type={!href ? type : undefined}
  disabled={!href ? disabled : undefined}
  href={href}
  target={href ? target : undefined}
  rel={href && target === "_blank" ? "noopener noreferrer" : undefined}
  id={id}
  aria-label={ariaLabel}
>
  <slot name="icon-left" />
  <span class="mx-1">
    <slot />
  </span>
  <slot name="icon-right" />
</Element>
