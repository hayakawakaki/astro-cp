---
type Props = {
  variant?: "normal" | "outline";
  bgColor?: "gray" | "red" | "yellow" | "green" | "blue" | "indigo" | "purple" | "pink";
  outlineColor?: "gray" | "red" | "yellow" | "green" | "blue" | "indigo" | "purple" | "pink" | "black" | "white";
  dot?: "gray" | "red" | "yellow" | "green" | "blue" | "indigo" | "purple" | "pink" | "black" | "white";
  size?: "sm" | "md" | "lg";
  class?: string;
};

const {
  variant = "normal",
  bgColor = "gray",
  outlineColor = "black",
  dot,
  size = "md",
  class: className = "",
} = Astro.props;

const sizeClasses = {
  sm: "px-2 py-0.5",
  md: "px-2.5 py-1",
  lg: "px-3 py-1.5",
};

const dotSizeClasses = {
  sm: "w-1.5 h-1.5",
  md: "w-2 h-2",
  lg: "w-2.5 h-2.5",
};

const bgColorClasses = {
  gray: "bg-gray-100",
  red: "bg-red-100",
  yellow: "bg-yellow-100",
  green: "bg-green-100",
  blue: "bg-blue-100",
  indigo: "bg-indigo-100",
  purple: "bg-purple-100",
  pink: "bg-pink-100",
};

const borderColorClasses = {
  gray: "border-gray-300",
  red: "border-red-300",
  yellow: "border-yellow-300",
  green: "border-green-300",
  blue: "border-blue-300",
  indigo: "border-indigo-300",
  purple: "border-purple-300",
  pink: "border-pink-300",
  black: "border-black",
  white: "border-white",
};

const dotColorClasses = {
  gray: "bg-gray-500",
  red: "bg-red-500",
  yellow: "bg-yellow-500",
  green: "bg-green-500",
  blue: "bg-blue-500",
  indigo: "bg-indigo-500",
  purple: "bg-purple-500",
  pink: "bg-pink-500",
  black: "bg-black",
  white: "bg-white",
};

const baseClasses = "inline-flex items-center gap-1.5";

const variantClasses = variant === "outline" ? `border ${borderColorClasses[outlineColor]}` : bgColorClasses[bgColor];

const badgeClasses = `${baseClasses} ${sizeClasses[size]} ${variantClasses} ${className}`;
---

<span class={badgeClasses}>
  {dot && <span class={`${dotSizeClasses[size]} ${dotColorClasses[dot]} rounded-full flex-shrink-0`} />}
  <slot />
</span>
