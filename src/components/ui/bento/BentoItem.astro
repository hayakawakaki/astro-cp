---
type GridSize = 1 | 2 | 3 | 4 | 5 | 6 | 7 | 8;

type Props = {
  baseCol?: GridSize;
  baseRow?: GridSize;
  class?: string;
};

const { baseCol = 1, baseRow = 1, class: className = "" } = Astro.props;

//= Tailwind can't handle dynamic variables like col-span-${value}, that's why it should be like this.
const colClass: Record<GridSize, string> = {
  1: "col-span-1",
  2: "col-span-2",
  3: "col-span-3",
  4: "col-span-4",
  5: "col-span-5",
  6: "col-span-6",
  7: "col-span-7",
  8: "col-span-8",
};

const rowClass: Record<GridSize, string> = {
  1: "row-span-1",
  2: "row-span-2",
  3: "row-span-3",
  4: "row-span-4",
  5: "row-span-5",
  6: "row-span-6",
  7: "row-span-7",
  8: "row-span-8",
};
---

<div class={`bg-white rounded-xl border border-primary-200 p-6 ${colClass[baseCol]} ${rowClass[baseRow]} ${className}`}>
  <slot />
</div>
