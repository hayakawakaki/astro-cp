---
import Navigation from "@/components/Navigation.astro";
import Dropdown from "@/components/ui/Dropdown.astro";
import config from "~/app-config";

const { user, serverName } = Astro.locals;
---

<header class="fixed inset-0 text-lg font-semibold h-max bg-primary-50 px-padding">
  <div class="container flex items-center justify-between mx-auto h-header py-v-space">
    <a href="/" class="content-center">
      <img class="max-h-8" src="/logo.png" alt={`${serverName}'s Logo'`} />
    </a>
    <nav class="hidden lg:flex lg:items-center lg:gap-x-6">
      <Navigation links={config.NavItem} />
    </nav>
  </div>
</header>

<script>
  import { signOut } from "@/lib/auth/auth-client";

  const logoutButton = document.getElementById("logout-button");
  logoutButton?.addEventListener("click", async () => {
    await signOut();
    window.location.reload();
  });
</script>
