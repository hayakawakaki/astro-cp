---
import { Image } from "astro:assets";

import Navigation from "@/components/Navigation.astro";
import config from "~/app-config";

const { serverName } = Astro.locals;
---

<header class="fixed inset-0 z-50 text-lg font-medium h-max bg-primary-50 px-padding font-primary">
  <div class="container flex items-center justify-between mx-auto h-header py-v-space">
    <a href="/" class="content-center">
      <Image src="/logo.png" alt={`${serverName}'s Logo'`} height={32} width={108} loading="eager" />
    </a>
    <nav class="hidden lg:flex lg:items-center lg:gap-x-6">
      <Navigation links={config.NavItem} />
    </nav>
  </div>
</header>
