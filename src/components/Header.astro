---
const user = Astro.locals.user;
import config from "@root/app-config";
---

<header class="fixed inset-0 w-full h-header bg-base-200">
  <div class="navbar px-0 container mx-auto h-full">
    <div class="navbar-start text-2xl">Astro Project</div>
    <div class="navbar-center">
      <ul class="menu menu-horizontal menu-lg font-semibold">
        {
          config.NavItem.map((item) => (
            <li>
              <a href={item.url} target={item.external ? "_blank" : "_self"}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="navbar-end">
      {
        user ? (
          <button id="logout-button" class="btn btn-lg btn-outline btn-neutral">
            Logout
          </button>
        ) : (
          <a href="/login" class="btn btn-soft btn-primary">
            Login
          </a>
        )
      }
    </div>
  </div>
</header>

<script>
  import { signOut } from "@/lib/auth/auth-client";

  const logoutButton = document.getElementById("logout-button");
  logoutButton?.addEventListener("click", async () => {
    await signOut();
    window.location.reload();
  });
</script>
