---
import type { ConfigNav, NavLink, NavLinkGroup } from "@/types/app-config.types";

import Button from "@/ui/Button.astro";
import Dropdown from "@/ui/Dropdown.astro";

function isGroup(item: NavLink | NavLinkGroup): item is NavLinkGroup {
  return "links" in item;
}

function isActive(path: string) {
  return Astro.url.pathname === path || Astro.url.pathname.startsWith(`${path}/`);
}

type Props = {
  links: ConfigNav;
};

const { links } = Astro.props;
const { user } = Astro.locals;
---

<Fragment>
  {
    links.map((item) => {
      if (!isGroup(item)) {
        const isCurrentPage = item.url ? isActive(item.url) : false;
        return (
          <a
            href={item.url}
            target={item.external ? "_blank" : "_self"}
            class={`relative pb-1 after:absolute after:bottom-0 after:left-0 after:h-0.5 after:transition-all after:duration-300 ${
              isCurrentPage ? "after:w-full after:bg-zinc-900" : "after:w-0 after:bg-zinc-600 hover:after:w-full"
            }`}
          >
            {item.label}
          </a>
        );
      }
 else {
        const isCurrentPage = item.links.some((link) => {
          return link.url && isActive(link.url);
        });
        return (
          <Dropdown
            links={item.links}
            class={`relative pb-1 after:absolute after:bottom-0 after:left-0 after:h-0.5 after:transition-all after:duration-300 ${
              isCurrentPage ? "after:w-full after:bg-zinc-900" : "after:w-0 after:bg-zinc-600 hover:after:w-full"
            }`}
            arrow
          >
            <span slot="label">{item.label}</span>
          </Dropdown>
        );
      }
    })
  }
  {
    // @click breaks the IDE styling for some reason
    !user?.id
? (
      <Button variant="secondary" size="lg" class="w-32 rounded-xl" x-data x-on:click="$store.auth.signIn('discord')">
        Login
      </Button>
    )
: (
      <Button variant="secondary" size="lg" class="w-32 rounded-xl" x-data x-on:click="$store.auth.signOut();">
        Logout
      </Button>
    )
  }
</Fragment>
