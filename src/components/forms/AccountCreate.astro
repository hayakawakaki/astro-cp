---
import "@css/tailwind.css";
---

<div class="card card-xl max-w-md bg-primary">
  <div class="card-body">
    <h2 class="card-title text-2xl">Create Game Account</h2>

    <div id="alert" class="alert hidden">
      <span id="alert-text"></span>
    </div>

    <form id="game-account-form" class="space-y-4">
      <div class="relative">
        <input type="text" name="userid" placeholder="Enter username" class="input input-bordered" required />
      </div>

      <div class="relative">
        <label class="label">
          <span class="label-text">Gender</span>
        </label>
        <select name="sex" class="select select-bordered">
          <option value="M">Male</option>
          <option value="F">Female</option>
        </select>
      </div>

      <button type="submit" class="btn btn-accent"> Create Account </button>
    </form>
  </div>
</div>
