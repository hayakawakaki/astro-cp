---
import Title from "@/components/Title.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/ui/Button.astro";

const { serverName } = Astro.locals;
---

<title>{`${serverName} / 404 Page`}</title>
<BaseLayout>
  <Title label="404 Page" />
  <div class="flex flex-col py-48 items-center w-full min-h-body gap-y-6">
    <h2 class="text-6xl font-semibold text-red-500">404</h2>
    <p class="text-4xl">Page not found</p>
    <Button href="/" size="xl" variant="secondary">Return Home</Button>
  </div>
</BaseLayout>
