---
import MobPage from "@theme/pages/MobPage";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getMobDatabase } from "@/lib/rathena-db/mob-db";
import Pagination from "@/utils/pagination";

const DB = await getMobDatabase();
const pagination = new Pagination(DB);
const currentPage = Number(Astro.url.searchParams.get("page")) || 1;
const pageData = pagination.paginize({ page: currentPage, pageSize: 30 });
---

<head>
  <title>Astro</title>
</head>

<BaseLayout>
  <MobPage pageData={pageData.items} currentPage={currentPage} />
</BaseLayout>
