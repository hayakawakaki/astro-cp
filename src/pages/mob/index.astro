---
import MobPage from "~theme/pages/mob/Page";

import BaseLayout from "@/layouts/BaseLayout.astro";
import Pagination from "@/utils/pagination";
import Title from "@/components/Title.astro";

import { getMobDatabase } from "@/lib/rathena";

const { serverName } = Astro.locals;

const DB = await getMobDatabase();

const pagination = new Pagination(DB);
const currentPage = Number(Astro.url.searchParams.get("page")) || 1;
const pageData = pagination.paginize({ page: currentPage, pageSize: 20 });
---

<title>{serverName} \ Mob</title>

<BaseLayout>
  <Title label="Mob Database Page" />
  <MobPage pageData={pageData} currentPage={currentPage} />
</BaseLayout>
