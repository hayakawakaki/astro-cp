---
import { getMobInfo } from "@/lib/rathena-db/mob-db";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getItemName } from "@/lib/rathena-db/item-db";

const { id } = Astro.params;
const mobId = parseInt(id as string);
const mobData = await getMobInfo(mobId);
if (!mobData) {
  return new Response(null, {
    status: 404,
    statusText: "This mob ID doesn't exist.",
  });
}

const serverName = Astro.locals.serverName;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{serverName} \ Mob \ {mobData.Name}</title>
  </head>
  <body>
    <BaseLayout>
      <div class="flex">
        <div class="flex min-h-64 min-w-64 border-amber-200 border-2 items-center justify-center">
          <img
            src=`/images/mob/${mobData.AegisName.toLowerCase()}.png`
            alt=`${mobData.Name}'s Image'`
            class="object-contain"
          />
        </div>
      </div>
    </BaseLayout>
  </body>
</html>
