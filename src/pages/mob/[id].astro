---
import MobIdPage from "~theme/pages/mob/Id";

import Title from "@/components/Title.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getMobInfo } from "@/lib/rathena";

const { serverName } = Astro.locals;

const { id } = Astro.params;
const mobId = Number.parseInt(id as string);
const mobData = await getMobInfo(mobId);
if (!mobData) {
  return new Response(null, {
    status: 404,
    statusText: "This mob ID doesn't exist.",
  });
}
---

<title>{serverName} \ Mob \ {mobData.Name}</title>

<BaseLayout>
  <Title label=`Mob Database - ${mobData.Name}` />
  <MobIdPage mobData={mobData} />
</BaseLayout>
