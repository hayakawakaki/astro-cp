---
import { getMobInfo } from "@/lib/rathena-db/mob-db";
import BaseLayout from "@layouts/BaseLayout.astro";

const { id } = Astro.params;
const mobId = parseInt(id as string);
const mobData = await getMobInfo(mobId);
if (!mobData) {
  return new Response(null, {
    status: 404,
    statusText: "This mob ID doesn't exist.",
  });
}
---

<BaseLayout>
  <div class="flex">
    <div class="grow">
      {mobData && Object.keys(mobData).map((item) => <p>{item}</p>)}
    </div>
    <div class="grow">
      {mobData && Object.values(mobData).map((item) => <p>{item}</p>)}
    </div>
  </div>
</BaseLayout>
