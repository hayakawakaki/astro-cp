---
import ItemPage from "@theme/pages/ItemPage";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getItemDatabase } from "@/lib/rathena-db/item-db";
import Pagination from "@/utils/pagination";

const DB = await getItemDatabase();
const pagination = new Pagination(DB);
const currentPage = Number(Astro.url.searchParams.get("page")) || 1;
const pageData = pagination.paginize({ page: currentPage, pageSize: 30 });
---

<head>
  <title>Item Page</title>
</head>

<BaseLayout>
  <ItemPage pageData={pageData.items} currentPage={currentPage} />
</BaseLayout>
