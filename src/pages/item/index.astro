---
import ItemPage from "@theme/pages/ItemPage";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getItemDatabase } from "@/lib/rathena-db/item-db";
import Pagination from "@/utils/pagination";

const DB = await getItemDatabase();
const pagination = new Pagination(DB);
const currentPage = Number(Astro.url.searchParams.get("page")) || 1;
const pageData = pagination.paginize({ page: currentPage, pageSize: 30 });
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro</title>
  </head>
  <body>
    <BaseLayout>
      <ItemPage pagination={pageData} currentPage={currentPage} />
    </BaseLayout>
  </body>
</html>
