---
import ItemInfo from "~theme/components/ItemInfo";

import BaseLayout from "@/layouts/BaseLayout.astro";

import { getItemInfo, getTradeRestrictions, whoDrops } from "@/lib/rathena";

const { serverName } = Astro.locals;
const { id } = Astro.params;
const itemId = parseInt(id as string);
const itemData = await getItemInfo(itemId);
if (!itemData) {
  return new Response(null, {
    status: 404,
    statusText: "This item ID doesn't exist.",
  });
}
const tradeRestrictions = getTradeRestrictions(itemData.Trade);
const dropData = await whoDrops(itemData.Id);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{serverName} : Item Database - {id}</title>
  </head>
  <body>
    <BaseLayout>
      <ItemInfo itemData={itemData} tradeRestriction={tradeRestrictions} dropData={dropData} />
    </BaseLayout>
  </body>
</html>
