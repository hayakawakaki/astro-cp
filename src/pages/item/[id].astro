---
import ItemIdPage from "~theme/pages/item/Id";

import BaseLayout from "@/layouts/BaseLayout.astro";
import { getItemInfo, getTradeRestrictionsDisplay, whoDrops } from "@/lib/rathena";

const { serverName } = Astro.locals;
const { id } = Astro.params;
const itemId = Number.parseInt(id as string);
const itemData = await getItemInfo(itemId);
if (!itemData) {
  return new Response(null, {
    status: 404,
    statusText: "This item ID doesn't exist.",
  });
}
const tradeRestrictions = getTradeRestrictionsDisplay(itemData.Trade);
const dropData = await whoDrops(itemData.Id);
---


<title>{serverName} \ Item \ {itemData.Name}</title>

<BaseLayout>
  <ItemIdPage itemData={itemData} tradeRestriction={tradeRestrictions} dropData={dropData} />
</BaseLayout>
