---
// src/pages/item/[id].astro
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getItemInfo } from "@/utils/item";

const { id } = Astro.params;
const itemID: number = parseInt(id as string);
console.log(itemID);
const item = await getItemInfo(itemID);
console.log(item);

if (!item) {
  return Astro.redirect("/404", 404);
}
---

<BaseLayout>
  <h1>{item.AegisName}</h1>
  <p>{item.Name}</p>
</BaseLayout>
