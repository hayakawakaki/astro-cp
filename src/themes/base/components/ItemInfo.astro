---
import type { ItemDatabaseFormat, WhoDropFormat } from "@/types";

type Props = {
  itemData: ItemDatabaseFormat;
  tradeRestriction: string[];
  dropData: Set<WhoDropFormat>;
};

const { itemData, tradeRestriction, dropData } = Astro.props;
---

<head>
  <title>Item Database - {itemData.Name}</title>
</head>

<div class="h-full grid grid-cols-6 grid-rows-6 gap-4">
  <div class="col-span-4 border-black border">
    <img
      src={`/images/collection/${itemData.Image}.webp`}
      onerror="this.src='/images/collection/NoImage.webp'"
      alt={`${itemData.Name}'s Image`}
    />
    {tradeRestriction.length > 0 && tradeRestriction.map(item => <p>{item}</p>)}
  </div>
  <div class="col-span-2 row-span-6 border-black border">
    {itemData.Description?.map(item => <p set:html={item} />)}
  </div>
  <div class="flex flex-col col-span-4 row-span-5 border-black border">
    {
      dropData
      && Array.from(dropData)
          .slice(0, 10)
          .map(item => <span>{item.mobId}</span>)
    }
  </div>
</div>
