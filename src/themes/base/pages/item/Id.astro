---
import type { ItemDatabaseFormat, WhoDropFormat } from "@/rathena";

import ItemCard from "@/components/rathena/ItemCard.vue";

type Props = {
  itemData: ItemDatabaseFormat;
  tradeRestriction: string[];
  dropData: Set<WhoDropFormat>;
};

const { itemData, dropData } = Astro.props;
---

<title>Item Database - {itemData.Name}</title>

<div class="grid h-full grid-cols-6 grid-rows-6 gap-4 ">
  <div class="col-span-4">
  <ItemCard itemData={itemData} client:load />
  </div>
  <div class="col-span-2 row-span-6 border border-black">
    {itemData.Description?.map(item => <p set:html={item} />)}
  </div>
  <div class="flex flex-col col-span-4 row-span-5 border border-black">
    {
      dropData
      && Array.from(dropData)
          .slice(0, 10)
          .map(item => <span>{item.mobId}</span>)
    }
  </div>
</div>
