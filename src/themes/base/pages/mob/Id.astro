---
import { Image } from "astro:assets";

import type { MobDatabaseFormat } from "@/rathena";

import { getItemInfo } from "@/rathena";

const { mobData } = Astro.props;
const data = mobData as MobDatabaseFormat;

function attackDisplay(): `${number}~${number}` {
  if (!data.Attack && !data.Attack2) {
    return "1~1";
  }
  if (!data.Attack2) {
    return `${data.Attack}~${data.Attack}`;
  }
  if (data.Attack > data.Attack2) {
    return `${data.Attack2}~${data.Attack}`;
  }
  return `${data.Attack}~${data.Attack2}`;
}

const tableData: { label: string; output: string }[] = [
  { label: "Size", output: data.Size || "Medium" },
  { label: "Race", output: data.Race || "Formless" },
  { label: "Element", output: `${data.Element || "Neutral"} ${data.ElementLevel || 1}` },
  { label: "Level", output: String(data.Level || 1) },
  { label: "HP", output: String(data.Hp?.toLocaleString("en") || 1) },
  { label: "Speed", output: String(data.WalkSpeed || 1000) },
  { label: "STR", output: String(data.Str || 1) },
  { label: "AGI", output: String(data.Agi || 1) },
  { label: "VIT", output: String(data.Vit || 1) },
  { label: "INT", output: String(data.Int || 1) },
  { label: "DEX", output: String(data.Dex || 1) },
  { label: "LUK", output: String(data.Luk || 1) },
  { label: "Attack", output: attackDisplay() },
  {
    label: "DEF/MDEF",
    output: `${String(data.Defense || 1)}/${String(data.MagicDefense || 1)}`,
  },
  {
    label: "RES/MRES",
    output: `${String(data.Resistance || 0)}/${String(data.MagicResistance || 0)}`,
  },
];
---

<div class="space-x-4 space-y-8 lg:columns-3">
  <section class="w-full break-inside-avoid">
    <h3 class="text-3xl font-medium text-center">- Mob Sprite -</h3>
    <div class="flex flex-col items-center justify-center border h-80 gap-y-v-space border-primary-300 rounded-2xl">
      <Image
        width={250}
        height={250}
        src=`/images/mob/${data.AegisName}.avif`
        alt={`${data.Name}'s Sprite`}
        class="object-scale-down w-auto max-h-32"
      />
      <h2 class="text-xl font-medium text-center text-nowrap">{data.Name}</h2>
    </div>
  </section>
  <section class="w-full break-inside-avoid">
    <h3 class="text-3xl font-medium text-center">- Mob Stats -</h3>
    <div class="border border-primary-300 rounded-2xl">
      <table class="w-full text-center">
        <tr class="h-16 py-1 border-b border-primary-300">
        {
          tableData.slice(0, 3).map(item => (
            <td class="size-24">
              <p class="text-sm font-normal text-zinc-500">{item.label}</p>
              <p class="font-medium">{item.output}</p>
            </td>
          ))
        }
        </tr>
        <tr class="border-b border-primary-300">
        {
          tableData.slice(3, 6).map(item => (
            <td class="size-24">
              <p class="text-sm font-normal text-zinc-500">{item.label}</p>
              <p class="font-medium">{item.output}</p>
            </td>
          ))
        }
        </tr>
        <tr class="border-b border-primary-300">
        {
          tableData.slice(6, 9).map(item => (
            <td class="size-24">
              <p class="text-sm font-normal text-zinc-500">{item.label}</p>
              <p class="font-medium">{item.output}</p>
            </td>
          ))
        }
        </tr>
        <tr>
        {
          tableData.slice(9, 12).map(item => (
            <td class="size-24">
              <p class="text-sm font-normal text-zinc-500">{item.label}</p>
              <p class="font-medium">{item.output}</p>
            </td>
          ))
        }
        </tr>
      </table>
    </div>
  </section>
  <section class="w-full break-inside-avoid">
    <h3 class="text-3xl font-medium text-center">- Mob Drops -</h3>
    <div class="border divide-y border-primary-300 rounded-2xl divide-primary-300">
    {
      data.Drops?.map(async (drop) => {
        const name = await getItemInfo(drop.Item, "Name");
        const image = await getItemInfo(drop.Item, "Image");
        const url = await getItemInfo(drop.Item, "AegisName");
        return (
          <div class="flex items-center justify-between px-2 py-2">
            <a class="h-full" href={`/item/${url}`}>
              <Image
                class="inline-block object-none max-h-6"
                width={24}
                height={24}
                src={`/images/item/${image}.webp`}
                alt={`${name}'s Sprite'`}
                loading="lazy"
              />
              <span class="text-sm font-medium text-blue-700 break-words">
                {name}
              </span>
            </a>
            <p>{`${((drop.Rate / 10000) * 100).toFixed(2)}%`}</p>
          </div>
        );
      })
    }
    </div>
  </section>
</div>
