---
import { Image } from "astro:assets";

import type { MobDatabaseFormat } from "@/rathena";

import { getItemInfo } from "@/rathena";
import BentoGrid from "@/ui/bento/BentoGrid.astro";
import BentoItem from "@/ui/bento/BentoItem.astro";

const { mobData } = Astro.props;
const data = mobData as MobDatabaseFormat;

function attackDisplay(): `${number}~${number}` {
  if (!data.Attack2) {
    return `${data.Attack}~${data.Attack}`;
  }
  if (data.Attack > data.Attack2) {
    return `${data.Attack2}~${data.Attack}`;
  }
  return `${data.Attack}~${data.Attack2}`;
}

const tableData: { label: string; output: string }[] = [
  { label: "Size", output: data.Size },
  { label: "Race", output: data.Race },
  { label: "Element", output: `${data.Element} ${data.ElementLevel}` },
  { label: "Level", output: String(data.Level) },
  { label: "HP", output: String(data.Hp.toLocaleString("en")) },
  { label: "Speed", output: String(data.WalkSpeed) },
  { label: "STR", output: String(data.Str) },
  { label: "AGI", output: String(data.Agi) },
  { label: "VIT", output: String(data.Vit) },
  { label: "INT", output: String(data.Int) },
  { label: "DEX", output: String(data.Dex) },
  { label: "LUK", output: String(data.Luk) },
  { label: "Attack", output: attackDisplay() },
  {
    label: "DEF/MDEF",
    output: `${String(data.Defense)}/${String(data.MagicDefense)}`,
  },
  {
    label: "RES/MRES",
    output: `${String(data.Resistance || 0)}/${String(data.MagicResistance || 0)}`,
  },
];
---

<BentoGrid class="auto-rows-[var(--spacing-bento)] gap-2 lg:gap-4">
  <BentoItem
    baseCol={12}
    baseRow={5}
    class="flex flex-col items-center h-full py-2 font-medium border gap-y-2 border-primary-200 rounded-2xl md:row-span-5 md:col-span-6 md:col-start-4 lg:col-start-3 lg:row-span-4 lg:col-span-4"
  >
    <Image
      width={250}
      height={250}
      src=`/images/mob/${data.AegisName}.avif`
      alt={`${data.Name}'s Sprite`}
      class="flex-1 object-scale-down w-auto min-h-0"
    />
    <h2 class="text-xl text-nowrap">{data.Name}</h2>
  </BentoItem>
  <BentoItem
    baseCol={12}
    baseRow={7}
    class="relative flex flex-col items-center h-full py-2 mt-4 font-medium border lg:mt-0 lg:py-4 rounded-2xl border-primary-200 md:row-span-5 lg:row-span-6 lg:col-span-4 lg:col-start-3"
  >
    <h3
      class="absolute content-center text-xl -translate-x-1/2 bg-background left-1/2 -top-3.5"
    >
      Status
    </h3>
    <section class="grid w-full h-full grid-cols-3 grid-rows-5">
      {
        tableData.map(item => (
          <div class="content-center col-span-1 text-center border-b border-primary-200 [&:nth-last-child(-n+3)]:border-b-0">
            <p class="text-sm font-normal text-zinc-500">{item.label}</p>
            <p>{item.output}</p>
          </div>
        ))
      }
    </section>
  </BentoItem>
  {
    data.Drops && (
      <BentoItem
        baseCol={12}
        class="w-full h-full py-2 mt-4 font-medium lg:col-span-3 lg:row-start-1 lg:col-start-7 lg:mt-0 lg:py-0"
      >
        <section class="relative grid justify-between grid-cols-1 auto-rows-[2.5rem] md:auto-rows-[2.5rem] border rounded-2xl border-primary-200 [&>div]:not-last:border-b [&>div]:not-last:border-b-primary-200">
          <h3 class="absolute content-center text-xl -translate-x-1/2 left-1/2 -top-3.5 bg-background border-0">
            Drops
          </h3>
          {data.Drops.map(async (drop) => {
            const name = await getItemInfo(drop.Item, "Name");
            const image = await getItemInfo(drop.Item, "Image");
            const url = await getItemInfo(drop.Item, "AegisName");
            return (
              <div class="flex items-center justify-between row-span-1 px-2">
                <a class="flex items-center h-full gap-2" href={`/item/${url}`}>
                  <Image
                    class="inline-block object-none max-h-6"
                    width={24}
                    height={24}
                    src={`/images/item/${image}.webp`}
                    alt={`${name}'s Sprite'`}
                    loading="lazy"
                  />
                  <span class="text-sm font-medium break-words text-blue-700">
                    {name}
                  </span>
                </a>
                <p>{`${((drop.Rate / 10000) * 100).toFixed(2)}%`}</p>
              </div>
            );
          })}
        </section>
      </BentoItem>
    )
  }
</BentoGrid>
