---
import { Image } from "astro:assets";

import type { MobDatabaseFormat } from "@/rathena";
import type { PaginationReturn } from "@/utils/pagination";

import DatabaseSearch from "@/components/forms/DatabaseSearch.vue";
import Pagination from "@/ui/Pagination.vue";
import ScrollProgress from "@/ui/ScrollProgress.vue";

type Props = {
  pageData: PaginationReturn<MobDatabaseFormat>;
  currentPage: number;
};

const { pageData, currentPage } = Astro.props;

const pageItems = pageData.items;
const { items, ...pageControl } = pageData;

function attackDisplay(atk1: number, atk2?: number): `${number}~${number}` {
  if (!atk1 && !atk2) {
    return `${atk1}~${atk1}`;
  }
  if (!atk2) {
    return `${atk1}~${atk1}`;
  }
  if (atk1 > atk2) {
    return `${atk2}~${atk1}`;
  }
  return `${atk1}~${atk2}`;
}
---

<ScrollProgress
  color="secondary"
  size="sm"
  position="bottom"
  class="border select-none h-body border-primary-300"
  client:load
>
  <div
    class="sticky top-0 z-20 flex items-center justify-between gap-x-2 px-2 pr-2 border-r min-h-12 border-primary-300 bg-background shadow-primary-300 shadow-[0_1px_0_0]"
  >
    <DatabaseSearch
      client:load
      id="mob-search"
      endpoint="/api/rathena/mob-search"
      baseURL="/mob"
      placeholder="Search Mob"
      maxResults={10}
      inputClass="w-full h-8 md:w-72 focus:placeholder:opacity-0"
    />
    <Pagination
      targetURL="mob"
      pageData={pageControl}
      currentPage={currentPage}
      color="secondary"
      size="sm"
      client:load
    />
  </div>
  <table class="w-full text-sm text-center">
    <thead
      class="sticky top-12 text-sm uppercase shadow-[0_1px_0_0] shadow-primary-300"
    >
      <tr class="z-20 divide-x h-7 divide-primary-300 bg-secondary-200 *:px-1">
        <th class="w-18">Sprite</th>
        <th class="w-18">Mob ID</th>
        <th class="w-auto md:w-[30rem]">Name</th>
        <th class="hidden w-20 md:table-cell">Size</th>
        <th class="hidden w-20 md:table-cell">Element</th>
        <th class="hidden w-20 md:table-cell">Level</th>
        <th class="hidden w-30 md:table-cell">HP</th>
        <th class="hidden w-30 lg:table-cell">Attack</th>
        <th class="hidden w-20 lg:table-cell">DEF/MDEF</th>
        <th class="hidden w-20 lg:table-cell">Speed</th>
        <th class="hidden w-20 lg:table-cell">Range</th>
        <th class="hidden w-16 xl:table-cell">STR</th>
        <th class="hidden w-16 xl:table-cell">AGI</th>
        <th class="hidden w-16 xl:table-cell">VIT</th>
        <th class="hidden w-16 xl:table-cell">INT</th>
        <th class="hidden w-16 xl:table-cell">DEX</th>
        <th class="hidden w-16 xl:table-cell">LUK</th>

      </tr>
    </thead>
    <tbody class="font-medium divide-y divide-primary-300">
      {
        pageItems.map((item, index) => (
          <tr class="divide-x divide-primary-300 *:px-1">
            <td class="text-secondary-500 py-1">
              <div class="h-16 content-center">
                <Image
                  width={64}
                  height={64}
                  src={`/images/mob/${item.AegisName}.avif`}
                  alt={`${item.Name} Sprite`}
                  loading={index > 5 ? "lazy" : "eager"}
                  class="object-contain w-auto max-h-full mx-auto"
                  onerror="this.onerror=null; this.src='/images/mob/poring.avif'"
                />
              </div>
            </td>
            <td class=" text-secondary-500">
              <a
                href={`/mob/${item.Id}`}
                target="_blank"
              >
                <span>{item.Id}</span>
              </a>
            </td>
            <td class=" text-secondary-500">
              <a
                href={`/mob/${item.Id}`}
                target="_blank"
              >
                <span>{item.Name}</span>
              </a>
            </td>
            <td class="hidden md:table-cell">{item.Size || "Medium"}</td>
            <td class="hidden md:table-cell">{`${item.Element || "Neutral"} ${item.ElementLevel || 1}`}</td>
            <td class="hidden md:table-cell">{item.Level || 1}</td>
            <td class="hidden md:table-cell">{item.Hp?.toLocaleString() || 10}</td>
            <td class="hidden lg:table-cell">{attackDisplay(item.Attack || 0, item?.Attack2 || 0)}</td>
            <td class="hidden lg:table-cell">{`${item.Defense || 0}/${item.MagicDefense || 0}`}</td>
            <td class="hidden lg:table-cell">{item.WalkSpeed || 1}</td>
            <td class="hidden lg:table-cell">{item.AttackRange || 1}</td>
            <td class="hidden xl:table-cell">{item.Str || 1}</td>
            <td class="hidden xl:table-cell">{item.Agi || 1}</td>
            <td class="hidden xl:table-cell">{item.Vit || 1}</td>
            <td class="hidden xl:table-cell">{item.Int || 1}</td>
            <td class="hidden xl:table-cell">{item.Dex || 1}</td>
            <td class="hidden xl:table-cell">{item.Luk || 1}</td>

          </tr>
        ))
      }
    </tbody>
  </table>
</ScrollProgress>
