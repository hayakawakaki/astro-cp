---
import { Image } from "astro:assets";

import type { MobDatabaseFormat } from "@/rathena";
import type { PaginationReturn } from "@/utils/pagination";

import DatabaseSearch from "@/components/forms/DatabaseSearch.vue";
import VSpace from "@/components/VSpace.astro";
import Button from "@/ui/Button.vue";

type Props = {
  pageData: PaginationReturn<MobDatabaseFormat>;
  currentPage: number;
};

const { pageData, currentPage } = Astro.props;

const maxPage = pageData.totalPages;
---

<VSpace />
<div class="grid grid-cols-20">
  <aside
    class="col-span-20 w-full flex justify-between items-center gap-2 px-2 py-1 sticky top-[var(--spacing-header-padding)] left-0 h-14 bg-background border z-10 border-primary-200"
  >
    <DatabaseSearch
      client:load
      id="mob-search"
      endpoint="/api/rathena/mob-search"
      baseURL="/mob"
      placeholder="Search Mob"
      maxResults={10}
      inputClass="w-24 h-10 md:w-60 focus:placeholder:opacity-0"
    />

    <div class="flex items-center h-10 grow md:grow-0" x-data="{value: ''}">
      <Button
        class="w-10 cursor-pointer rounded-tl-md rounded-bl-md"
        variant="solid"
        color="secondary"
        disabled={!pageData.hasPrev}
        @click="window.location.href = '/mob?page=' + (currentPage - 1)"
      >
        <span>«</span>
      </Button>

      <label
        class="h-full border border-primary-200 max-w-32 focus-within:border-primary-300"
      >
        <span class="sr-only">Current Page</span>
        <input
          type="number"
          name="pageInput"
          x-model="value"
          class="content-center w-full h-full text-sm font-medium text-center bg-transparent placeholder:text-font focus:placeholder:opacity-0 outline-0"
          placeholder={`${currentPage}`}
          @keyup="if (parseInt(value) > maxPage) value = maxPage"
          @keyup.enter="window.location.href = '/mob?page=' + value"
        />
      </label>
      <Button
        class="w-10 cursor-pointer rounded-tr-md rounded-br-md"
        variant="solid"
        color="secondary"
        disabled={!pageData.hasNext}
        @click="window.location.href = '/mob?page=' + (currentPage + 1)"
      >
        <span>»</span>
      </Button>
    </div>
  </aside>
  <div
    class="sticky left-0 text-md md:text-lg font-medium top-[calc(var(--spacing-header-padding)+3.5rem)] grid h-8 border border-t-0 text-center grid-cols-subgrid col-span-20 bg-background border-primary-200 *:border-primary-200 *:not-last:border-r *:h-full *:content-center"
  >
    <div class="col-span-6 text-center md:col-span-4">Sprite</div>
    <p class="hidden text-center md:block md:col-span-2">Mob ID</p>
    <div class="col-span-9 text-center md:col-span-4">Name</div>
    <div class="hidden text-center md:block md:col-span-2">Size</div>
    <div class="hidden text-center md:block md:col-span-3">Race</div>
    <div class="hidden text-center md:block md:col-span-2">Element</div>
    <div class="col-span-5 text-center md:col-span-3">Details</div>
  </div>
  <div
    class="grid auto-rows-[5rem] *:content-center *:text-center *:not-last:border-r grid-cols-subgrid col-span-20 border border-b-0 border-primary-200 text-sm font-medium border-t-0 *:border-b *:border-primary-200"
  >
    {
      pageData.items.map((item, index) => (
        <Fragment>
          <div class="h-full col-span-6 md:col-span-4 border-primary-200">
            <Image
              width={250}
              height={250}
              src={`/images/mob/${item.AegisName}.avif`}
              alt={`${item.Name} Sprite`}
              loading={index > 5 ? "lazy" : "eager"}
              class="object-contain w-auto max-h-full mx-auto"
              onerror="this.onerror=null; this.src='/images/mob/poring.avif'"
            />
          </div>
          <p class="hidden md:block md:col-span-2 border-primary-200">
            {item.Id}
          </p>
          <p class="h-full col-span-9 text-center md:col-span-4 border-primary-200">
            {item.Name}
          </p>
          <p class="hidden md:block md:col-span-2 border-primary-200">
            {item.Size}
          </p>
          <p class="hidden md:block md:col-span-3 border-primary-200">
            {item.Race}
          </p>
          <p class="hidden md:block md:col-span-2 border-primary-200">{`${item.Element} ${item.ElementLevel}`}</p>
          <div class="grid w-full col-span-5 md:col-span-3 place-items-center">
            <Button
              variant="solid"
              color="secondary"
              class="h-12 text-center rounded-lg w-18 md:h-12 md:w-24 lg:w-32"
              href={`/mob/${item.Id}`}
              target="_blank"
            >
              View Details
            </Button>
          </div>
        </Fragment>
      ))
    }
  </div>
</div>

<script is:inline define:vars={{ maxPage, currentPage }}>
  window.maxPage = maxPage;
  window.currentPage = currentPage;
</script>
