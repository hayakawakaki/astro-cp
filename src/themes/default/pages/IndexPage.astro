---
import config from "~/app-config";
import Button from "@/ui/Button.astro";
import Badge from "@/ui/Badge.astro";
import BentoGrid from "@/ui/bento/BentoGrid.astro";
import BentoItem from "@/ui/bento/BentoItem.astro";
import { serverStatus } from "@/lib/rathena";
import { Image } from "astro:assets";

const { loginStatus, charStatus, mapStatus, totalOnlineCount, onlineCount, vendorCount, gmCount, uniqueCount } =
  await serverStatus.getStatus();

const { serverName, user } = Astro.locals;
const data = config.ServerInfo;
---

<BentoGrid class="h-body auto-rows-[var(--spacing-bento)] gap-2">
  <BentoItem
    baseCol={12}
    baseRow={8}
    class="relative *:z-0 overflow-hidden flex flex-col items-center justify-center gap-4 p-4 text-center bg-primary-100 rounded-3xl lg:col-span-8 lg:row-span-6"
  >
    <Image
      src="/logo.png"
      alt="Logo"
      width={660}
      height={200}
      loading="eager"
      class="w-auto max-h-20 md:max-h-24 lg:max-h-32"
    />
    <Image
      src="/background/gear.webp"
      alt="Logo"
      width={200}
      height={200}
      loading="eager"
      class="absolute bottom-0 right-0 w-auto opacity-5 max-h-72"
    />
    <p class="text-xl font-semibold">Welcome to {serverName}</p>
    <p class="text-lg font-semibold">A rathena control panel built on top of Astro</p>
    <div class="inline-flex items-end justify-center w-full gap-2">
      <Button
        variant="secondary"
        size="lg"
        class="h-14 min-w-36 md:min-w-40 rounded-4xl md:text-lg"
        href="https://discord.gg">Join Discord</Button
      >
      {
        user?.id ? (
          <Button href="/account" variant="primary" size="lg" class="h-14 min-w-36 md:min-w-40 rounded-4xl md:text-lg">
            View Account
          </Button>
        ) : (
          <Button href="/login" variant="primary" size="lg" class="h-14 min-w-36 md:min-w-40 rounded-4xl md:text-lg">
            Play Now
          </Button>
        )
      }
    </div>
  </BentoItem>
  <BentoItem
    baseCol={12}
    baseRow={3}
    class="relative flex flex-col items-center justify-center p-4 overflow-hidden text-center *:z-0 bg-secondary-100 rounded-3xl gap-y-2 lg:col-span-4 lg:row-span-3 lg:justify-center"
  >
    <Image
      src="/background/check.webp"
      alt="Logo"
      width={200}
      height={200}
      loading="eager"
      class="absolute bottom-0 right-0 w-auto opacity-[3%] max-h-48"
    />
    <h3 class="text-xl font-semibold">Server Status</h3>
    <div class="flex items-center justify-center gap-x-2">
      <Badge
        variant="outline"
        outlineColor="gray"
        size="md"
        class="font-semibold rounded-2xl"
        dot={mapStatus ? "green" : "red"}
      >
        Map
      </Badge>
      <Badge
        variant="outline"
        outlineColor="gray"
        size="md"
        class="font-semibold rounded-2xl"
        dot={charStatus ? "green" : "red"}
      >
        Char
      </Badge>
      <Badge
        variant="outline"
        outlineColor="gray"
        size="md"
        class="font-semibold rounded-2xl"
        dot={loginStatus ? "green" : "red"}
      >
        Login
      </Badge>
    </div>
  </BentoItem>
  <BentoItem
    baseCol={12}
    baseRow={4}
    class="relative overflow-hidden flex flex-col items-center *:z-0 justify-center p-4 text-center bg-accent-50 rounded-3xl gap-y-2 lg:col-span-4 lg:row-span-3 lg:justify-center"
  >
    <Image
      src="/background/online.webp"
      alt="Logo"
      width={200}
      height={200}
      loading="eager"
      class="absolute bottom-0 right-0 w-auto opacity-[3%] max-h-48"
    />
    <h3 class="text-xl font-semibold">Online Counter</h3>
    <div class="flex flex-wrap items-center justify-center gap-2">
      <Badge size="lg" bgColor="green" class="font-semibold">Total : {totalOnlineCount}</Badge>
      <Badge size="lg" bgColor="yellow" class="font-semibold">Gepard : {uniqueCount}</Badge>
      <Badge size="lg" bgColor="indigo" class="font-semibold">Online : {onlineCount}</Badge>
      <Badge size="lg" bgColor="purple" class="font-semibold">Vendor : {vendorCount}</Badge>
      <Badge size="lg" bgColor="red" class="font-semibold">GM : {gmCount}</Badge>
    </div>
  </BentoItem>
</BentoGrid>
