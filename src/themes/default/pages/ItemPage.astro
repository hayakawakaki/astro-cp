---
import type { ItemDatabaseFormat } from "@/types";
type Props = {
  pageData: ItemDatabaseFormat[];
  currentPage: number;
};

const { pageData, currentPage } = Astro.props;
---

<div class="flex flex-col h-full gap-y-4 p-2 bg-base-100 border-2 border-base-300 rounded-xl">
  <div class="flex justify-between">
    <label class="input">
      <svg class="h-[1em] opacity-50" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
        <g stroke-linejoin="round" stroke-linecap="round" stroke-width="2.5" fill="none" stroke="currentColor">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </g>
      </svg>
      <input type="search" required placeholder="Search Item" />
    </label>
    <div class="join">
      <a href={`?page=${currentPage - 1}`} class="join-item btn">«</a>
      <button class="join-item btn">Page {currentPage}</button>
      <a href={`?page=${currentPage + 1}`} class="join-item btn">»</a>
    </div>
  </div>
  <div class="grow">
    <div class="flex flex-col">
      {pageData.map((item) => <a href={`/item/${item.Id}`}>{item.Name}</a>)}
    </div>
  </div>
</div>
