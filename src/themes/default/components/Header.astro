---
const user = Astro.locals.user;
---

<header class="navbar h-16">
  <div class="navbar-start text-2xl">Astro Project</div>
  <div class="navbar-center gap-x-4 flex">
    <a>Home</a>
    <a>Database</a>
  </div>
  <div class="navbar-end">
    {
      user ? (
        <details class="dropdown">
          <summary class="btn m-1 bg-yellow-500">Account</summary>
          <ul class="menu dropdown-content bg-zinc-500 rounded-box z-1 w-52  p-2 shadow-sm">
            <li>
              <a>Info</a>
            </li>
            <li>
              <a>Control</a>
            </li>
            <li>
              <a>Logout</a>
            </li>
          </ul>
        </details>
      ) : (
        <a href="/login" class="btn btn-soft btn-primary">
          Login
        </a>
      )
    }
  </div>
</header>
