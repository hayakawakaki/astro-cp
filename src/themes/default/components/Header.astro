---
const user = Astro.locals.user;
---

<header class="navbar h-16">
  <div class="navbar-start text-2xl">Astro Project</div>
  <div class="navbar-center gap-x-4 flex">
    <a>Home</a>
    <a>Database</a>
  </div>
  <div class="navbar-end">
    {
      user ? (
        <button id="logout-button" class="btn btn-soft btn-primary">
          Logout
        </button>
      ) : (
        <a href="/login" class="btn btn-soft btn-primary">
          Login
        </a>
      )
    }
  </div>
</header>

<script>
  import { authService } from "@lib/auth/auth-client";

  const logoutButton = document.getElementById("logout-button");

  logoutButton?.addEventListener("click", async () => {
    await authService.signOut();
    window.location.reload();
  });
</script>
