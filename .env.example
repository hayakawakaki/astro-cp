SERVER_HOST=127.0.0.1
MAP_PORT=5121
CHAR_PORT=6121
LOGIN_PORT=6900

DB_HOST=127.0.0.1
DB_USERNAME=mysql_user
DB_PASSWORD=mysql_password
DB_NAME=mysql_db

# Set to production when deploying
NODE_ENV=development

# Generate at https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=better_auth_secret

# OAuth Client And Secrets
# Generate at respective dev websites
# If you're adding another auth provider, make sure you also add it at src/lib/env-schema
DISCORD_CLIENT_ID=discord_client_id
DISCORD_CLIENT_SECRET=discord_client_secret
GOOGLE_CLIENT_ID=google_client_id
GOOGLE_CLIENT_SECRET=google_client_secret