{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/css/*": ["./src/assets/css/*"],
      "@/layouts/*": ["./src/components/layouts/*"],
      "@/ui/*": ["./src/components/ui/*"],
      "~/*": ["./*"]
    }
  },
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ]
}
